# Swiss Energy MCP — configuration template.
# The server contacts only public, auth-free APIs; no secrets are required.
# Copy to .env for local overrides. All variables use the SWISS_ENERGY_ prefix.

# Transport: "stdio" (Claude Desktop) or "http" (Streamable HTTP / cloud).
SWISS_ENERGY_TRANSPORT=stdio

# Host for HTTP transport. Default 127.0.0.1 (loopback only).
# Set to 0.0.0.0 ONLY inside a container (see Dockerfile).
SWISS_ENERGY_HOST=127.0.0.1

# Port for HTTP transport.
SWISS_ENERGY_PORT=8000

# Comma-separated allowed CORS origins for HTTP transport.
SWISS_ENERGY_CORS_ORIGINS=https://claude.ai

# Log level: DEBUG | INFO | WARNING | ERROR.
SWISS_ENERGY_LOG_LEVEL=INFO

# Upstream HTTP timeout in seconds.
SWISS_ENERGY_HTTP_TIMEOUT=20
